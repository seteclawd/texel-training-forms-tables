{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "texel-training-forms-tables",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "texel-training-forms-tables-db",
      "database_id": "ab3e1cc3-4804-400d-b2b0-9e0491bdaf90"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "seteclawd-files" }
  ],
  "observability": { "enabled": true }
}
