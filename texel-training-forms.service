[Unit]
Description=Texel Air Training Forms PWA
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/sete/openclaw-nas/.openclaw/workspace/texel-training-forms
ExecStart=/usr/bin/node /home/sete/openclaw-nas/.openclaw/workspace/texel-training-forms/server/index.cjs
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=default.target
